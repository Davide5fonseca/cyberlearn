# ⚠️ Este ficheiro é um EXEMPLO. Copia-o para `.env` e preenche com os teus valores.
# Nunca commits valores reais neste ficheiro — ele é versionado no Git.

# Porta do servidor
PORT=8080

# Base de dados PostgreSQL
DB_DATABASE=cyberlearn
DB_USER=postgres
DB_PASSWORD=<password-da-base-de-dados>
DB_HOST=localhost
DB_PORT=5432
# Certificado CA do fornecedor da BD (opcional; ativa validação TLS estrita)
# DB_CA_CERT=

# Email (Gmail App Password — gerar em https://myaccount.google.com/apppasswords)
EMAIL_USER=<conta>@gmail.com
EMAIL_PASS=<app-password-de-16-caracteres>

# Segredo para assinar os JSON Web Tokens (gerar um valor longo e aleatório)
# Ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<gerar-valor-aleatorio>

# Origens autorizadas para CORS, separadas por vírgula
FRONTEND_ORIGINS=http://localhost:5173,https://cyberlearn-frontend.vercel.app
